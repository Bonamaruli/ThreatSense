# ============================================================
# CONTOH KONFIGURASI — SALIN JADI .env LALU ISI NILAI ASLINYA
#   cp .env.example .env
#
# JANGAN PERNAH menulis password asli di file ini.
# File .env.example IKUT ter-commit ke git, sedangkan .env TIDAK.
# ============================================================

# Database
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/threatsense

# Redis
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_NAME=ThreatSense
DEBUG=True

# Buat nilai acak dengan:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<isi-dengan-random-string-minimal-32-karakter>

# ML Settings
# Path absolut ke folder ml/models milikmu
MODEL_PATH=<path-absolut>/ThreatSense/ml/models
MLFLOW_TRACKING_URI=http://localhost:5000
